<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_bg" android:layoutDirection="rtl" android:gravity="center_vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="آية اليوم" android:textColor="#E3C57E" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_ayah" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:textColor="#F6F0DC" android:textSize="17sp" android:lineSpacingMultiplier="1.25"
        android:ellipsize="end" android:maxLines="4" android:gravity="center_vertical|start" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_ref" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#CFE3DA" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_wird" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E3C57E" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
